.git
.gitignore
__pycache__/
*.py[cod]
.venv/
venv/
# Runtime state & secrets — MUST NOT enter the image (Dockerfile does `COPY . .`,
# and image layers get pushed to DOCR). Runtime reads these from the /data volume
# instead: VOICEGUARD_JOBS_DB, VOICEGUARD_AUTH_KEYS, VOICEGUARD_JOBS_INPUT.
auth_keys.json
*.db
*.db-wal
*.db-shm
jobs_input/
# The tamper-evident audit log is RUNTIME state, written to /data/governance in
# the container (VOICEGUARD_GOVERNANCE_DIR). Baking the developer's local log in
# would make production's chain-of-custody continue from laptop test detections.
governance/
.env
.env.*
!.env.example
# Dev artifacts with no runtime role.
*.docx
.pytest_cache/
voice_guard 0ffline/
# weights & data. CI appends an exception for the version selected by the
# remote ACTIVE pointer before building, so the image runs fully offline while
# inactive bundles stay out of the build context.
models/
model_store/*
!model_store/ACTIVE.json
!model_store/registry.jsonl
!model_store/v9h
data/
cv-corpus-*/
bias_audit/
bias_audit_fakes/
studio_clips/
studio_fake_test/
studio_fp_results/
adapted_checkpoints/
new_samples/
held_out/
mlruns/
output/
explain_out/
.superpowers/
archive/
*.rar
*.zip
*.wav
*.mp3
*.m4a
*.flac
!tests/golden_clips/
# CC0 probe set for the promotion health gate (REMEDIATION_PLAN D9). Without it
# the gate cannot certify inside the image and --skip-health becomes routine.
!tests/probe_clips/
*.log
