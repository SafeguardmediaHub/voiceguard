# ── Model weights & large binaries (never commit; tracked via the registry) ──
*.pt
*.onnx
*.pth
*.rar
*.zip

# ── Model bundle store: track manifests + pointer/registry logs, ignore weights ──
model_store/*/*.pt
model_store/*/*.json
!model_store/*/bundle.json
!model_store/ACTIVE.json
!model_store/registry.jsonl

# ── Audio (except the small tracked golden clips) ──
*.wav
*.m4a
*.mp3
*.flac
*.ogg
*.opus
!tests/golden_clips/**

# ── Experiment tracking / run outputs ──
mlruns/
mlflow.db
output/
*_report_*.txt
*_report_*.json
drift_log.jsonl
drift_alert_state.json

# ── Large data / corpora / generated sets ──
data/
cv-corpus-*/
bias_audit/
bias_audit_fakes/
studio_clips/
studio_fake_test/
studio_fp_results/
studio_processed_fake_test/
v8_finetune_combined/
adapted_checkpoints/
new_samples/
held_out/

# ── Nested duplicate project directory (do not track) ──
voice_guard 0ffline/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ── Scratch / editor ──
phase_plan.txt
*.tmp
.DS_Store
.vscode/
.idea/

# API key store (per-environment; hashed keys, never commit)
auth_keys.json

# Async job queue runtime state (per-environment)
jobs.db
jobs.db-wal
jobs.db-shm
jobs_input/

# Load-test runtime artifacts (per-run throwaway)
loadtest_jobs.db
loadtest_jobs.db-*
loadtest_keys.json
loadtest_input/

# ── Session scratch & dev-only (not part of the shipped project) ──
.superpowers/
explain_out/
archive/
# Root-level only: these are dev leftovers like drift_monitor_v8_backup.py.
# Unanchored, this also swallowed tests/test_backup.py — a real test that must
# reach CI. archive/ is already ignored wholesale on the line above.
/*_backup.py
debug.py
file.py
_v8mod.py
*.log

# ── One-off / superseded scripts (not part of the shipped system) ──
averstial_detector.py
bias_1.py
bias_2.py
fre_arab.py
drift_monitor.py
fetch_studio_clips.py
